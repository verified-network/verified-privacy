{
  "private": true,
  "version": "0.2.0",
  "description": "Verified Investments",
  "main": "",
  "scripts": {
    "start": "node --max-old-space-size=6114 server.js --env=dev",
    "build-css": "node-sass-chokidar --include-path ./src/styles --include-path ./node_modules src/styles/ -o src/styles/",
    "watch-css": "npm run build-css && node-sass-chokidar --include-path ./src/styles --include-path ./node_modules src/styles/ -o src/styles --watch --recursive",
    "clean": "rimraf dist/*",
    "copy": "copyfiles -f ./src/index.html ./src/firebase-messaging-sw.js ./src/favicon.ico ./dist",
    "dist": "set NODE_OPTIONS=--max_old_space_size=4096 && npm run copy && webpack --env=dist --mode production",
    "lint": "eslint --fix ./src",
    "posttest": "npm run lint",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags",
    "serve": "node server.js --env=dev",
    "serve:dist": "node server.js --env=dist",
    "test": "karma start",
    "test:watch": "karma start --autoWatch=true --singleRun=false"
  },
